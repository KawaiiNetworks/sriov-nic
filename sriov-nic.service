[Unit]
Description=Configure SR-IOV NIC physical functions
After=systemd-modules-load.service systemd-udev-settle.service network-pre.target
Before=networking.service
Wants=systemd-udev-settle.service network-pre.target

[Service]
Type=oneshot
ExecStart=%INSTALL_DIR%/set-sriov-all.sh
ExecStartPost=%INSTALL_DIR%/prepare-ovs.sh
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
